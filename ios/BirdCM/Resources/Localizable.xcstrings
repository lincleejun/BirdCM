    "观察记录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Observations"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观察记录"
          }
        }
      }
    },
    "观察记录 = 同一鸟种、同一天、同一地点合为一次；估计数量取同日同地点单张照片的最大值，可能重复见到同一只鸟；地点未知的同日记录合并，可能低估次数。新种 = 这段时间里第一次记录到的鸟种。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Observation = the same species on the same day at the same place, counted once; the estimated count is the largest count in a single photo for that day and place, and the same bird may be seen more than once; records with an unknown place on the same day are merged, which may undercount. New species = species recorded for the first time in this period."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观察记录 = 同一鸟种、同一天、同一地点合为一次；估计数量取同日同地点单张照片的最大值，可能重复见到同一只鸟；地点未知的同日记录合并，可能低估次数。新种 = 这段时间里第一次记录到的鸟种。"
          }
        }
      }
    },
