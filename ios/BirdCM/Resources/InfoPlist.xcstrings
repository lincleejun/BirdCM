{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GuanYu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观羽"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo of a bird to identify it; the photo is kept only in GuanYu’s records on this device and is not saved to Photos automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍一张鸟的照片来识别；照片只保存在观羽的本机记录里，不会自动存入相册。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a photo has no GPS, your current location is used to refine the species; you can still identify if you decline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片没有 GPS 时，用当前地点修正鸟种；拒绝仍可识别。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the bird image you choose to Photos; asked only when you tap Save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你选择的鸟图保存到相册，仅在点击保存时请求。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
